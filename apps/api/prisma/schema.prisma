// Prisma schema for Vectra — 1:1 mapping of the approved domain design.
// Source of truth for the domain: docs/architecture/data-model.md (RFC-0006).
// Technical mapping decisions: docs/decisions/0002-prisma-domain-mapping.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URL lives in prisma.config.ts (Prisma 7 convention).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TransactionType {
  EXPENSE
  INCOME
}

enum AccountType {
  CASH
  BANK
  CREDIT_CARD
  OTHER
}

enum BudgetPeriod {
  MONTHLY
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

/// Frequency of a reusable expense item (ADR-0005). ONE_TIME items are real
/// costs but never feed the recurring projections — they are surfaced apart
/// so a single purchase does not inflate a monthly total.
enum ExpenseItemFrequency {
  MONTHLY
  YEARLY
  ONE_TIME
}

/// Frequency of an income (ADR-0005). Wider than ExpenseItemFrequency —
/// weekly pay is common, weekly subscriptions are not. Kept as its own enum
/// so both domains can evolve without dragging the other along.
enum IncomeFrequency {
  WEEKLY
  MONTHLY
  YEARLY
  ONE_TIME
}

/// Lifecycle/visibility state of a Scenario (ADR-0006). Purely a visibility
/// flag, not a baseline: several scenarios can be ACTIVE at once, since
/// "active" means "candidate for comparison", not "my one true situation".
enum ScenarioStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id              String   @id @default(uuid(7)) @db.Uuid
  email           String   @unique
  /// bcrypt hash — the plain password never touches the database (RFC-0010).
  passwordHash    String
  /// ISO 4217 code. MVP: single currency per user (business rule 9).
  defaultCurrency String   @db.Char(3)
  timezone        String   @default("UTC")
  /// First day of week for reports: 0 = Sunday … 6 = Saturday.
  weekStartsOn    Int      @default(1) @db.SmallInt
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts              Account[]
  categories            Category[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  savingGoals           SavingGoal[]
  refreshTokens         RefreshToken[]
  expenseItems          ExpenseItem[]
  incomes               Income[]
  scenarios             Scenario[]

  @@map("users")
}

/// One row per active session. Stores a SHA-256 hash of an opaque random
/// token — never the token itself — so a DB leak cannot be replayed as a
/// session. Rotated on every refresh; `revokedAt` supports logout and
/// reuse detection (RFC-0010).
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Account {
  id         String      @id @default(uuid(7)) @db.Uuid
  userId     String      @db.Uuid
  name       String
  type       AccountType
  /// ISO 4217 code. Present per account from day one (scalability note, RFC-0006 §8).
  currency   String      @db.Char(3)
  /// Accounts with transactions are archived, never deleted (business rule 3).
  archivedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]

  @@index([userId])
  @@map("accounts")
}

model Category {
  id         String          @id @default(uuid(7)) @db.Uuid
  userId     String          @db.Uuid
  name       String
  /// A category is either expense or income, never both (business rule 2).
  type       TransactionType
  /// Marks the per-user "Sin categorizar" categories created at registration.
  /// System categories cannot be renamed, archived or deleted: future flows
  /// (transactions RFC) rely on them as the re-categorization fallback.
  isSystem   Boolean         @default(false)
  /// Categories with transactions are archived, never deleted (business rule 3).
  archivedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  expenseItems          ExpenseItem[]

  @@index([userId])
  @@map("categories")
}

/// Immutable ledger entry (RFC-0006 §1). Balances and budget progress are
/// always derived from this table, never stored (business rule 7).
model Transaction {
  id                     String          @id @default(uuid(7)) @db.Uuid
  accountId              String          @db.Uuid
  /// Required: uncategorized transactions land in a per-user default
  /// "Uncategorized" category (open question 3, resolved 2026-07-22).
  categoryId             String          @db.Uuid
  /// Set when generated from a template; the transaction stays independent
  /// of later template edits (business rule 5). Together with `date` it forms
  /// a unique key: the processor can never generate the same occurrence twice
  /// (RFC-0015 idempotency), while manual transactions (NULL here) are
  /// unconstrained — Postgres treats NULLs as distinct in unique indexes.
  recurringTransactionId String?         @db.Uuid
  /// Money VO: amount + currency. Always positive; direction comes from `type`.
  amount                 Decimal         @db.Decimal(12, 2)
  currency               String          @db.Char(3)
  /// Must match the category's type (business rule 2) — enforced in the
  /// service layer, not expressible as a DB constraint via Prisma.
  type                   TransactionType
  /// Calendar date of the movement; time of day is not part of the domain.
  date                   DateTime        @db.Date
  note                   String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  account              Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category             Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)

  @@unique([recurringTransactionId, date])
  @@index([accountId, date])
  @@index([categoryId, date])
  @@map("transactions")
}

/// Template that generates Transactions over time; not itself a money movement.
model RecurringTransaction {
  id         String              @id @default(uuid(7)) @db.Uuid
  userId     String              @db.Uuid
  accountId  String              @db.Uuid
  categoryId String              @db.Uuid
  /// Money VO. The transaction type derives from the category (business rule 2).
  amount     Decimal             @db.Decimal(12, 2)
  currency   String              @db.Char(3)
  frequency  RecurrenceFrequency
  startDate  DateTime            @db.Date
  endDate    DateTime?           @db.Date
  /// System-managed schedule pointer: the next occurrence the processor
  /// should generate. Seeded to `startDate` on create and advanced by the
  /// processor — never set directly by the client (RFC-0015).
  nextExecutionDate DateTime     @db.Date
  /// Pause/resume switch. A paused template keeps its `nextExecutionDate`,
  /// so resuming catches up rather than losing the schedule.
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([userId])
  @@index([isActive, nextExecutionDate])
  @@map("recurring_transactions")
}

model Budget {
  id         String       @id @default(uuid(7)) @db.Uuid
  userId     String       @db.Uuid
  categoryId String       @db.Uuid
  /// Money VO: spending limit for the category within each period.
  amount     Decimal      @db.Decimal(12, 2)
  currency   String       @db.Char(3)
  period     BudgetPeriod
  /// Archived in cascade with its category (RFC-0006 §7). Uniqueness of the
  /// ACTIVE budget per user+category+period requires a partial unique index
  /// (WHERE archived_at IS NULL) added via raw SQL in the migrations phase;
  /// until then it is enforced in the service layer. See ADR-0002.
  archivedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, categoryId])
  @@map("budgets")
}

/// A reusable expense the user can drop into any scenario (Netflix, Claude,
/// gym...). Exists exactly once per user: categories organize items and
/// scenarios reference them, so a price change is a single edit (ADR-0005).
/// Never produces a Transaction — an item is a hypothetical cost, not a
/// ledger movement.
model ExpenseItem {
  id         String               @id @default(uuid(7)) @db.Uuid
  userId     String               @db.Uuid
  /// Required: every item belongs to exactly one category. When the user adds
  /// an item from a scenario, the UI creates the category inline rather than
  /// letting the item exist uncategorized (ADR-0005).
  categoryId String               @db.Uuid
  name       String
  /// Money VO. Always positive — an item is a cost by definition; direction
  /// is implied, unlike Transaction where it comes from `type`.
  amount     Decimal              @db.Decimal(12, 2)
  currency   String               @db.Char(3)
  frequency  ExpenseItemFrequency
  /// Items referenced by a scenario are archived, never deleted — business
  /// rule 3 carried over to the scenario domain. Uniqueness of the ACTIVE
  /// name per user is enforced in the service layer (same partial-index
  /// caveat as Budget, see ADR-0002).
  archivedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  scenarioItems ScenarioItem[]

  @@index([userId])
  @@index([categoryId])
  @@map("expense_items")
}

/// Money coming in: salary, freelance, dividends, bonuses (ADR-0005).
/// Independent of scenarios — the optional scenario ↔ income link lands with
/// the Scenario RFC, and an income is perfectly usable without one.
model Income {
  id         String          @id @default(uuid(7)) @db.Uuid
  userId     String          @db.Uuid
  name       String
  /// Money VO. Always positive; ONE_TIME incomes are excluded from the
  /// recurring projections for the same reason as ONE_TIME expense items.
  amount     Decimal         @db.Decimal(12, 2)
  currency   String          @db.Char(3)
  frequency  IncomeFrequency
  archivedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  scenarioIncomes ScenarioIncome[]

  @@index([userId])
  @@map("incomes")
}

/// A named simulation: an explicit selection of expense items, optionally
/// composed with other scenarios and linked to incomes for coverage (ADR-0005,
/// ADR-0006). Never stores totals or projections — always derived from its
/// selection at read time (business rule 6, inherited from ADR-0004/0005).
model Scenario {
  id     String         @id @default(uuid(7)) @db.Uuid
  userId String         @db.Uuid
  name   String
  /// Visibility state, not a baseline — see ScenarioStatus. Uniqueness of the
  /// active name per user is enforced in the service layer (same partial-index
  /// caveat as ExpenseItem/Income, see ADR-0002).
  status ScenarioStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items              ScenarioItem[]
  incomes            ScenarioIncome[]
  /// Scenarios this one includes (this is the parent side).
  includedScenarios  ScenarioComposition[] @relation("ParentScenario")
  /// Scenarios that include this one (this is the included side) — needed to
  /// block deleting a scenario that another scenario still references
  /// (business rule 3) and to reject cycles (business rule 1).
  includingScenarios ScenarioComposition[] @relation("IncludedScenario")

  @@index([userId])
  @@map("scenarios")
}

/// Join Scenario ↔ ExpenseItem: a "live" reference (ADR-0006 vivacity table) —
/// the scenario stores no snapshot of price/name/frequency, so editing the
/// item is reflected instantly everywhere it is selected.
model ScenarioItem {
  id            String   @id @default(uuid(7)) @db.Uuid
  scenarioId    String   @db.Uuid
  expenseItemId String   @db.Uuid
  /// Provenance only, not a live relation (ADR-0006): set when the item
  /// entered via "add whole category", left untouched afterwards even if the
  /// item later changes category. No FK on purpose — comparing it against the
  /// item's *current* categoryId is exactly what powers the passive
  /// category-change notice (business rule 8), and it must never cascade.
  addedViaCategoryId String? @db.Uuid
  addedAt            DateTime @default(now())

  scenario    Scenario    @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  expenseItem ExpenseItem @relation(fields: [expenseItemId], references: [id], onDelete: Restrict)

  @@unique([scenarioId, expenseItemId])
  @@index([expenseItemId])
  @@index([addedViaCategoryId])
  @@map("scenario_items")
}

/// Self-join Scenario ↔ Scenario: composing a scenario into another is
/// "live" (ADR-0006) — if the included scenario's selection changes, the
/// parent's total recalculates on its own. Cycle prohibition (business rule 1)
/// is enforced in the service layer, not expressible as a Prisma constraint.
model ScenarioComposition {
  id                 String   @id @default(uuid(7)) @db.Uuid
  parentScenarioId   String   @db.Uuid
  includedScenarioId String   @db.Uuid
  addedAt            DateTime @default(now())

  parentScenario   Scenario @relation("ParentScenario", fields: [parentScenarioId], references: [id], onDelete: Cascade)
  includedScenario Scenario @relation("IncludedScenario", fields: [includedScenarioId], references: [id], onDelete: Restrict)

  @@unique([parentScenarioId, includedScenarioId])
  @@index([includedScenarioId])
  @@map("scenario_compositions")
}

/// Join Scenario ↔ Income, many-to-many: a scenario's income coverage sums
/// every linked income (ADR-0006) — most users have more than one source.
model ScenarioIncome {
  id         String   @id @default(uuid(7)) @db.Uuid
  scenarioId String   @db.Uuid
  incomeId   String   @db.Uuid
  addedAt    DateTime @default(now())

  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  income   Income   @relation(fields: [incomeId], references: [id], onDelete: Restrict)

  @@unique([scenarioId, incomeId])
  @@index([incomeId])
  @@map("scenario_incomes")
}

/// Designed now, implemented in roadmap Phase 3 — not part of the MVP build.
model SavingGoal {
  id            String     @id @default(uuid(7)) @db.Uuid
  userId        String     @db.Uuid
  name          String
  /// Money VO. Both amounts are non-negative (business rule 10) — enforced in
  /// the service layer; CHECK constraints are not expressible in Prisma schema.
  targetAmount  Decimal    @db.Decimal(12, 2)
  currentAmount Decimal    @default(0) @db.Decimal(12, 2)
  currency      String     @db.Char(3)
  targetDate    DateTime?  @db.Date
  status        GoalStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saving_goals")
}

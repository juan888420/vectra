# PostgreSQL connection string used by Prisma (see prisma.config.ts).
DATABASE_URL="postgresql://user:password@localhost:5432/vectra_dev?schema=public"

# Signs JWT access tokens. Minimum 32 characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-random-string-of-at-least-32-chars"

# Optional — defaults shown (see src/config/env.ts).
# NODE_ENV="development"
# HOST="127.0.0.1"
# PORT="3001"

# Absolute path to the built SPA (apps/web/dist). Required in production,
# where this server also serves the frontend (ADR-0008). Leave unset in
# development: Vite serves the SPA and proxies /api to this server.
# WEB_DIST_DIR="/app/apps/web/dist"

# Reverse proxies in front of this server (0 = none, X-Forwarded-For ignored).
# Set to the real hop count in production; the image sets 1 for Railway.
# TRUST_PROXY_HOPS="0"
